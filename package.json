{
  "name": "@timonwa/react-hooks",
  "version": "0.0.0",
  "description": "Typed React hooks for the DOM problems every app hits — theme, media queries, countdowns, object URLs, click-outside, visibility, page titles. Client-side by design, no framework assumptions.",
  "keywords": [
    "react",
    "hooks",
    "theme",
    "dark-mode",
    "media-query",
    "typescript"
  ],
  "license": "MIT",
  "author": "Timonwa Akintokun",
  "homepage": "https://github.com/Timonwa/react-hooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timonwa/react-hooks.git"
  },
  "bugs": "https://github.com/Timonwa/react-hooks/issues",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:exports": "attw --pack . --profile node16",
    "check:publish": "publint",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:publish && pnpm check:exports",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@timonwa/app-utilities": "^0.4.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.4.0",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^3.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.18",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.3.0",
    "publint": "^0.3.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,json,md}": "biome check --write --no-errors-on-unmatched"
  }
}
